        var litProxyContractABIAddress = '';
        var litCustomContractABIAddress = '';
        
        var customAbiChainId = '1';
        
        var strNetwork = 'mainnet';
        var litCurrencyCode = 'USD';
        var LitAdvancedModeAvailable = 'true';
        var sid = '1f86f51c5a25c3e393db893e0d941d8f';
        var addressType = 'EOA, EOAHighActivity';
        var litGotSafeLabel = '0';
        var isSignedIn = '0';
        function initPerpsPagination() {
            let pageSize = 10;
            const table = document.getElementById('perpsTable');
            const footer = document.getElementById('perpsPagination');
            if (!table || !footer) return;

            const rows = Array.from(table.querySelectorAll('tbody tr'));
            const pageSizeSelect = document.getElementById('perpsPageSize');
            if (rows.length <= pageSize) {
                footer.hidden = true;
                rows.forEach(row => row.hidden = false);
                return;
            }

            const summary = footer.querySelector('[data-perps-pagination-summary]');
            const pages = footer.querySelector('[data-perps-pagination-pages]');
            let currentPage = 1;

            function render(page) {
                const totalPages = Math.ceil(rows.length / pageSize);
                currentPage = Math.min(page, totalPages);
                const first = (currentPage - 1) * pageSize;
                const last = Math.min(first + pageSize, rows.length);
                rows.forEach((row, index) => row.hidden = index < first || index >= last);
                summary.textContent = 'Showing ' + (first + 1) + '–' + last + ' of ' + rows.length;
                pages.innerHTML = '';
                if (pageSizeSelect) pageSizeSelect.disabled = rows.length <= pageSize;

                function addPage(label, target, disabled, active) {
                    const item = document.createElement('li');
                    item.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                    const link = document.createElement('button');
                    link.type = 'button';
                    link.className = 'page-link';
                    link.textContent = label;
                    link.disabled = disabled;
                    if (!disabled) link.addEventListener('click', () => render(target));
                    item.appendChild(link);
                    pages.appendChild(item);
                }

                addPage('Previous', currentPage - 1, currentPage === 1, false);
                for (let number = 1; number <= totalPages; number++) {
                    addPage(String(number), number, false, number === currentPage);
                }
                addPage('Next', currentPage + 1, currentPage === totalPages, false);
                footer.hidden = false;
            }

            if (pageSizeSelect) {
                pageSizeSelect.addEventListener('change', function () {
                    pageSize = parseInt(this.value, 10) || 10;
                    render(1);
                });
            }

            render(currentPage);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPerpsPagination);
        } else {
            initPerpsPagination();
        }
    </script>

