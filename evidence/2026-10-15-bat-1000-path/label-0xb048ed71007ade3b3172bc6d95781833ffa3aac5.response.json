                                                if (chain == "Sepolia") {
                                                    alert("Sepolia Test Network has already been added to Metamask.");
                                                    return;
                                                }
                                            }
                                        });
                                } else {
                                    alert("Please Install Metamask");
                                }
                            }
                        }
                    }
                } else {
                    alert('Unable to locate a compatible web3 browser!');
                }
            }
        }
