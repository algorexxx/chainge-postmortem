children\":\"EthDepositMessage.calculateDepositTxId\"}],\".\"]}]\n55:[\"$\",\"p\",null,{\"children\":[\"The transaction may not be sent to the child chain yet, but the transaction hash will be the one returned via \",[\"$\",\"code\",null,{\"children\":\"getEthDeposits()\"}],\".\"]}]\n56:[\"$\",\"$L48\",null,{\"as\":\"h2\",\"id\":\"tracing-retryables-from-child-chain-to-parent-chain\",\"children\":\"Tracing retryables from child chain to parent chain\"}]\n57:[\"$\",\"p\",null,{\"children\":[\"Tracing a retryable ticket from child chain to parent chain has multiple steps but is not too complicated. First, you need to create a contract for the \",\"$Lb9\",\" precompile and take the hash of the retryable message and use it as a log query for the \",[\"$\",\"code\",null,{\"children\":\"RedeemScheduled\"}],\" event. This is a unique value, so there will only be one log. Once that log is found, get the transaction hash of the log—this is the retryable ticket hash. Grab the transaction info of the retryable ticket and parse its information; it contains a value called \",[\"$\",\"code\",null,{\"children\":\"requestId\"}],\". This is a unique value given to each retryable ticket and is also an indexed value for the \",[\"$\",\"code\",null,{\"children\":\"MessageDelivered\"}],\" log on the parent chain \",[\"$\",\"$L49\",null,{\"title\":\"Bridge\",\"content\":[\"$\",\"p\",null,{\"children\":[\"A set of smart contracts for sending \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#crosschain-message\",\"children\":\"Cross-chain messages\"}],\" between blockchains. Every \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#arbitrum-chain\",\"children\":\"Arbitrum chain\"}],\" includes a bridge to/from its \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#parent-chain\",\"children\":\"Parent chain\"}],\".\"]}],\"children\":\"bridge\"}],\" contract. Query the logs using the \",[\"$\",\"code\",null,{\"children\":\"requestId\"}],\", and you'll get a single log, which will contain the transaction hash information.\"]}]\n58:[\"$\",\"p\",null,{\"children\":[\"If you have the hash of the actual ticket and not the message that is executed from the ticket, you can skip finding the \",[\"$\",\"code\",null,{\"children\":\"RedeemScheduled\"}],\" event and go straight to getting the \",[\"$\",\"code\",null,{\"children\":\"requestId\"}],\".\"]}]\nba:Tb41,\u003csvg viewBox=\"0 0 24 24\"\u003e\u003cpath d=\"M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48 3.087-2.292 4.105-2.295zm-9.77.02c1.012 0 2.514.808 4.11 2.28-.686.72-1.37 1.537-2.02 2.442-1.107.117-2.154.298-3.113.538-.112-.49-.195-.964-.254-1.42-.23-1.868.054-3.32.714-3.707.19-.09.4-.127.563-.132zm4.882 3.05c.455.468.91.992 1.36 1.564-.44-.02-.89-.034-1.345-.034-.46 0-.915.01-1.36.034.44-.572.895-1.096 1.345-1.565zM12 8.1c.74 0 1.477.034 2.202.093.406.582.802 1.203 1.183 1.86.372.64.71 1.29 1.018 1.946-.308.655-.646 1.31-1.013 1.95-.38.66-.773 1.288-1.18 1.87-.728.063-1.466.098-2.21.098-.74 0-1.477-.035-2.202-.093-.406-.582-.802-1.204-1.183-1.86-.372-.64-.71-1.29-1.018-1.946.303-.657.646-1.313 1.013-1.954.38-.66.773-1.286 1.18-1.868.728-.064 1.466-.098 2.21-.098zm-3.635.254c-.24.377-.48.763-.704 1.16-.225.39-.435.782-.635 1.174-.265-.656-.49-1.31-.676-1.947.64-.15 1.315-.283 2.015-.3