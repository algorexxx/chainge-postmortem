$Lc0\",\"\\n\",\"$Lc1\",\"\\n\",\"$Lc2\",\"\\n\",\"$Lc3\",\"\\n\",\"$Lc4\",\"\\n\",\"$Lc5\",\"\\n\",\"$Lc6\",\"\\n\",\"$Lc7\",\"\\n\",\"$Lc8\",\"\\n\",\"$Lc9\",\"\\n\",\"$Lca\",\"\\n\",\"$Lcb\",\"\\n\",\"$Lcc\",\"\\n\",\"$Lcd\",\"\\n\",\"$Lce\",\"\\n\",\"$Lcf\",\"\\n\",\"$Ld0\",\"\\n\",\"$Ld1\",\"\\n\",\"$Ld2\",\"\\n\",\"$Ld3\",\"\\n\",\"$Ld4\",\"\\n\",\"$Ld5\",\"\\n\",\"$Ld6\",\"\\n\",\"$Ld7\",\"\\n\",\"$Ld8\",\"\\n\",\"$Ld9\",\"\\n\",\"$Lda\",\"\\n\",\"$Ldb\",\"\\n\",\"$Ldc\",\"\\n\",\"$Ldd\",\"\\n\",\"$Lde\",\"\\n\",\"$Ldf\",\"\\n\",\"$Le0\",\"\\n\",\"$Le1\",\"\\n\",\"$Le2\",\"\\n\",\"$Le3\",\"\\n\",\"$Le4\",\"\\n\",\"$Le5\",\"\\n\",\"$Le6\",\"\\n\",\"$Le7\",\"\\n\",\"$Le8\",\"\\n\",\"$Le9\",\"\\n\",\"$Lea\",\"\\n\",\"$Leb\"]}]}]}]\n5a:[\"$\",\"$L48\",null,{\"as\":\"h2\",\"id\":\"tracing-depositeth-from-child-chain-to-parent-chain\",\"children\":[\"Tracing \",[\"$\",\"code\",null,{\"children\":\"DepositEth\"}],\" from child chain to parent chain\"]}]\n5b:[\"$\",\"p\",null,{\"children\":[\"If you want to trace an \",[\"$\",\"code\",null,{\"children\":\"DepositEth\"}],\" message from child to parent chain, it requires a bit more work and is not as efficient. Even though \",[\"$\",\"strong\",null,{\"children\":\"ETH\"}],\" deposit messages are given a \",[\"$\",\"code\",null,{\"children\":\"requestId\"}],\", the child chain transaction is not given that information, meaning you have no means of using it to query the parent chain bridge logs efficiently. Instead, you must rely on the \",[\"$\",\"code\",null,{\"children\":\"SequencerInbox\"}],\" contract — see \",\"$Lec\",\" for how batches and \",[\"$\",\"code\",null,{\"children\":\"SequencerBatchDelivered\"}],\" fit into the protocol.\"]}]\n5c:[\"$\",\"p\",null,{\"children\":[\"The first thing to do is find which \",[\"$\",\"$L49\",null,{\"title\":\"Batch\",\"content\":[\"$\",\"p\",null,{\"children\":[\"A group of Arbitrum transactions posted in a single transaction on the \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#underlying-chain\",\"children\":\"Underlying Chain\"}],\" into the \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#sequencer-inbox\",\"children\":\"Sequencer Inbox\"}],\" by the \",[\"$\",\"$L18\",null,{\"href\":\"/glossary#sequencer\",\"children\":\"Sequencer\"}],\".\"]}],\"children\":\"batch\"}],\" your child chain transaction is in. With that info, you can query the \",[\"$\",\"code\",null,{\"children\":\"SequencerInbox\"}],\" contract to find the block number that the batch was posted in, giving you certainty that the original parent chain message was sent before the block with the posted batch. From there, search through the \",[\"$\",\"code\",null,{\"children\":\"Bridge\"}],\" contract for their \",[\"$\",\"code\",null,{\"children\":\"MessageDelivered\"}],\" logs. You can then wrap the transaction that was responsible for emitting those logs with \",[\"$\",\"code\",null,{\"children\":\"ParentEthDepositTransactionReceipt\"}],\". When wrapped, you can call \",[\"$\",\"code\",null,{\"children\":\"getEthDeposits\"}],\", and if the hash calculated matches the hash you have, then that is the original parent chain message.\"]}]\ned:Tb41,\u003csvg viewBox=\"0 0 24 24\"\u003e\u003cpath d=\"M14.23 12.004a2.236 2.236 0 0 1-2.235 2.236 2.236 2.236 0 0 1-2.236-2.236 2.236 2.236 0 0 1 2.235-2.236 2.236 2.236 0 0 1 2.236 2.236zm2.648-10.69c-1.346 0-3.107.96-4.888 2.622-1.78-1.653-3.542-2.602-4.887-2.602-.41 0-.783.093-1.106.278-1.375.793-1.683 3.264-.973 6.365C1.98 8.917 0 10.42 0 12.004c0 1.59 1.99 3.097 5.043 4.03-.704 3.113-.39 5.588.988 6.38.32.187.69.275 1.102.275 1.345 0 3.107-.96 4.888-2.624 1.78 1.654 3.542 2.603 4.887 2.603.41 0 .783-.09 1.106-.275 1.374-.792 1.683-3.263.973-6.365C22.02 15.096 24 13.59 24 12.004c0-1.59-1.99-3.097-5.043-4.032.704-3.11.39-5.587-.988-6.38-.318-.184-.688-.277-1.092-.278zm-.005 1.09v.006c.225 0 .406.044.558.127.666.382.955 1.835.73 3.704-.054.46-.142.945-.25 1.44-.96-.236-2.006-.417-3.107-.534-.66-.905-1.345-1.727-2.035-2.447 1.592-1.48